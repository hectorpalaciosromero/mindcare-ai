		{
			"name": "1. Auth & Registration",
			"item": [
				{
					"name": "1.1 Register New Patient",
					"event": [
						{"listen": "prerequest", "script": {"exec": ["pm.environment.set('test_email', 'e2e_' + Date.now() + '@correo.com');"], "type": "text/javascript"}},
						{"listen": "test", "script": {"exec": ["pm.test('Status 201', () => pm.response.to.have.status(201));", "pm.test('Returns token', () => pm.expect(pm.response.json().access_token).to.be.a('string'));", "pm.test('Role is patient', () => pm.expect(pm.response.json().role).to.eql('patient'));"], "type": "text/javascript"}}
					],
					"request": {
						"method": "POST",
						"header": [{"key": "Content-Type", "value": "application/json"}],
						"body": {"mode": "raw", "raw": "{\"email\": \"{{test_email}}\", \"password\": \"SecurePass123\", \"role\": \"patient\", \"first_name\": \"E2E\", \"last_name\": \"Test\", \"age\": 25}", "options": {"raw": {"language": "json"}}},
						"url": {"raw": "{{base_url}}/api/auth/register", "host": ["{{base_url}}"], "path": ["api", "auth", "register"]}
					}
				},
				{
					"name": "1.2 Login — Patient",
					"event": [{"listen": "test", "script": {"exec": ["pm.test('Status 200', () => pm.response.to.have.status(200));", "pm.test('Save patient token', function () {", "    var json = pm.response.json();", "    pm.expect(json.access_token).to.be.a('string');", "    pm.environment.set('patient_token', json.access_token);", "});"], "type": "text/javascript"}}],
					"request": {
						"method": "POST",
						"header": [{"key": "Content-Type", "value": "application/json"}],
						"body": {"mode": "raw", "raw": "{\"email\": \"america.singer@correo.com\", \"password\": \"1234567\"}", "options": {"raw": {"language": "json"}}},
						"url": {"raw": "{{base_url}}/api/auth/login", "host": ["{{base_url}}"], "path": ["api", "auth", "login"]}
					}
				},
				{
					"name": "1.3 Patient Profile (GET /me)",
					"event": [{"listen": "test", "script": {"exec": ["pm.test('Status 200', () => pm.response.to.have.status(200));", "pm.test('Has email', () => pm.expect(pm.response.json().email).to.be.a('string'));", "pm.test('Has role', () => pm.expect(pm.response.json().role).to.eql('patient'));"], "type": "text/javascript"}}],
